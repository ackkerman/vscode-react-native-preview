{
  "name": "rn-preview",
  "displayName": "React Native Preview",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onCommand:rnPreview.open",
    "onCommand:rnPreview.restartMetro",
    "onCommand:rnPreview.reload"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rnPreview.open",
        "title": "React Native: Open Preview"
      },
      {
        "command": "rnPreview.restartMetro",
        "title": "React Native: Restart Metro"
      },
      {
        "command": "rnPreview.reload",
        "title": "React Native: Reload Preview"
      }
    ],
    "configuration": {
      "title": "React Native Preview",
      "properties": {
        "rnPreview.previewUrl": {
          "type": "string",
          "default": "http://localhost:19006",
          "description": "URL used by the preview iframe (e.g. http://localhost:19006)."
        }
      }
    }
  },
  "scripts": {
    "prebuild": "npm run lint",
    "build": "tsc -p .",
    "lint": "eslint . --ext .ts",
    "test": "npm run build && xvfb-run -a dbus-run-session -- node ./dist/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "@vscode/test-electron": "^2.4.0",
    "eslint": "^8.57.0",
    "mocha": "^10.7.3",
    "typescript": "5.5.4"
  }
}
